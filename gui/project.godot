; Graphoskop graphical interface (Godot 4.7).

config_version=5

[application]

config/name="Graphoskop"
config/description="Graphical interface of the Graphoskop network analysis library."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/subwindows/embed_subwindows=false

[gui]

theme/custom="res://theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.97, 0.97, 0.98, 1)
