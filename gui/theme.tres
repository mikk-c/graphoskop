[gd_resource type="Theme" load_steps=3 format=3]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Segoe UI", ".AppleSystemUIFont", "SF Pro Text", "Helvetica Neue", "Cantarell", "Ubuntu", "Noto Sans", "DejaVu Sans", "sans-serif")

[sub_resource type="SystemFont" id="SystemFont_code"]
font_names = PackedStringArray("Cascadia Mono", "Consolas", "SF Mono", "Menlo", "Ubuntu Mono", "DejaVu Sans Mono", "monospace")

[resource]
default_font = SubResource("SystemFont_ui")
default_font_size = 14
CodeEdit/fonts/font = SubResource("SystemFont_code")
