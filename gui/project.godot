; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Graphoskop"
config/description="Graphical interface of the Graphoskop network analysis library."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=16667
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://icon.png"

[audio]

driver/driver="Dummy"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=905
window/size/window_height_override=372
window/size/borderless=true
window/size/window_width_override.editor=0
window/size/window_height_override.editor=0
window/size/borderless.editor=false
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gsk_export/plugin.cfg")

[gui]

theme/custom="res://theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.97, 0.97, 0.98, 1)
